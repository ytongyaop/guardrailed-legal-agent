{
  "spec": "docs/design/006-frontend-migration.md §2 端点表（权限矩阵由该表逐端点归纳，批次 1 冻结）",
  "anonymous": ["setup", "setup_admin", "login", "register"],
  "user": [
    "auth_me",
    "logout",
    "onboarding",
    "check",
    "qa",
    "contracts",
    "contract_parse",
    "enterprise",
    "history",
    "history_trend",
    "history_delete",
    "settings_ui",
    "settings_password",
    "report"
  ],
  "admin": [
    "auth_me",
    "logout",
    "onboarding",
    "check",
    "qa",
    "contracts",
    "contract_parse",
    "enterprise",
    "history",
    "history_trend",
    "history_delete",
    "settings_ui",
    "settings_password",
    "report",
    "settings_model",
    "admin_users",
    "admin_role",
    "admin_statutes",
    "admin_rules",
    "admin_logs",
    "admin_evaluation"
  ],
  "forbidden_for_user": [
    "settings_model",
    "admin_users",
    "admin_role",
    "admin_statutes",
    "admin_rules",
    "admin_logs",
    "admin_evaluation"
  ],
  "endpoints": {
    "setup": ["GET /setup", "GET /setup/sample-contract"],
    "setup_admin": ["POST /setup/admin"],
    "login": ["POST /auth/login"],
    "register": ["POST /auth/register"],
    "auth_me": ["GET /auth/me"],
    "logout": ["POST /auth/logout"],
    "onboarding": ["POST /auth/onboarding"],
    "settings_password": ["PUT /auth/password"],
    "enterprise": ["GET /enterprise", "PUT /enterprise", "DELETE /enterprise"],
    "contracts": ["GET /contracts", "GET /contracts/{contract_id}", "DELETE /contracts/{contract_id}"],
    "contract_parse": ["POST /contracts/parse"],
    "check": [
      "POST /checks",
      "GET /jobs/{job_id}",
      "GET /tasks/{task_id}",
      "POST /tasks/{task_id}/answers",
      "POST /tasks/{task_id}/optional-facts"
    ],
    "qa": ["POST /tasks/{task_id}/qa"],
    "history": ["GET /history"],
    "history_trend": ["GET /history/trend"],
    "history_delete": ["DELETE /history/{task_id}"],
    "report": ["GET /tasks/{task_id}/report"],
    "settings_ui": ["GET /settings/ui", "PUT /settings/ui"],
    "settings_model": [
      "GET /settings/model",
      "PUT /settings/model",
      "POST /settings/model/{provider}/test",
      "DELETE /settings/model/{provider}",
      "PUT /settings/embedding",
      "DELETE /settings/embedding"
    ],
    "admin_users": ["GET /admin/users", "DELETE /admin/users/{user_id}"],
    "admin_role": ["PATCH /admin/users/{user_id}/role"],
    "admin_statutes": ["GET /admin/statutes"],
    "admin_rules": ["GET /admin/rules"],
    "admin_logs": ["GET /admin/logs", "GET /admin/logs/export"],
    "admin_evaluation": ["GET /admin/evaluation"]
  }
}
